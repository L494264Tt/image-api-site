APP_NAME=Image API Site Backend
APP_HOST=0.0.0.0
APP_PORT=8000
UPSTREAM_BASE_URL=https://your-openai-compatible-gateway.example
UPSTREAM_API_KEY=sk-REPLACE_ME
UPSTREAM_IMAGE_PATH=/v1/responses
UPSTREAM_MODEL=gpt-image-2
UPSTREAM_RESPONSES_MODEL=gpt-5.4
UPSTREAM_TIMEOUT_SECONDS=240
DATABASE_URL=postgresql+psycopg://postgres:replace-with-a-strong-database-password@postgres:5432/image_api_site
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=10080
IMAGE_STORAGE_DIR=/app/storage/images
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
CORS_ORIGINS=http://localhost:5173
